# Supabase — get from supabase.com > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...use-service-role-not-anon...

# Gemini — get from aistudio.google.com > Get API Key
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# JWT — generate any long random string (min 32 chars)
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# File storage — local folder for uploaded audio files
UPLOAD_DIR=./uploads

# CORS — comma separated, no spaces, must include your frontend URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
